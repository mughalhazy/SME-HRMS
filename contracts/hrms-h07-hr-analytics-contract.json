      "workaround": "Stub panel displayed with gap notice referencing BG-019"
    }
  ],

  "design_patterns": {
    "P-07": "Chip anatomy: padding 2px 8px, border-radius 99px, font-size 11px, font-weight 600, uppercase, letter-spacing .04em — applied to health chips (Healthy/At Risk/Critical) and saved report chips (PDF/CSV/Active/Paused)",
    "P-11": "Table row hover: transition:background .12s on tbody tr:hover td",
    "P-20": "Analytics layout: 6-tab report-nav, filter-bar (Period/Dept/Location), topbar actions (Export PDF / Schedule Report / New Report primary)",
    "P-27": "--dur-micro:120ms used for tab hover, row hover, bar chart hover",
    "P-31": "html{zoom:1.1} applied globally",
    "P-32": ".page{flex:1;overflow-y:auto;min-height:0} + .content{padding:22px 22px 12vh}"
  },

  "tab_inventory": [
    { "id": "workforce",  "label": "Workforce",         "status": "built",  "api_types": ["workforce.dashboard.summary", "workforce.attrition.summary"] },
    { "id": "payroll",    "label": "Payroll",            "status": "stub",   "gap": "BG-018" },
    { "id": "attendance", "label": "Attendance & Leave", "status": "built",  "api_types": ["workforce.attendance.trend"] },
    { "id": "recruiting", "label": "Recruiting",         "status": "built",  "api_types": ["hiring.pipeline.summary", "hiring.funnel.summary", "hiring.source.effectiveness", "hiring.time_to_hire"] },
    { "id": "performance","label": "Performance",        "status": "stub",   "gap": "BG-019" },
    { "id": "saved",      "label": "Saved Reports",      "status": "built",  "api_types": ["reports list", "schedules list"] }
  ]
}
