        { "field": "leave_type", "style": "grey" },
        { "field": "total_days", "suffix": "days", "style": "grey" }
      ]
    },

    "LAYOUT": {
      "type": "2col-no-tabs",
      "left_width": "1fr",
      "right_width": "292px"
    },

    "LEFT_COLUMN": [
      {
        "card": "Request Details",
        "service": "leave_service",
        "model": "LeaveRequest",
        "endpoint": "GET /api/v1/leave/requests/:requestId",
        "fields": ["leave_request_id", "leave_type", "start_date", "end_date", "total_days", "reason", "approver_employee_id", "status", "submitted_at", "decision_at"]
      },
      {
        "card": "AI Assessment",
        "type": "ai-card",
        "variant": "teal-informational",
        "confidence_display": true,
        "dismissable": true,
        "note": "P-12 — teal = informational, no action required"
      },
      {
        "card": "Approval History",
        "type": "timeline",
        "source": "GET /api/v1/leave/requests/:requestId/workflow-history"
      }
    ],

    "RIGHT_COLUMN": [
      {
        "card": "Leave Balance",
        "type": "balance-card",
        "gap": "BG-006",
        "note": "No backend endpoint. Mock data used. Requires GET /api/v1/leave/employees/:employeeId/balances",
        "fields": ["leave_type", "entitlement_days", "taken_days", "pending_days", "remaining_days"]
      },
      {
        "card": "After Approval Impact",
        "type": "derived",
        "description": "Shows remaining balance if this request is approved",
        "source": "derived: remaining_days - total_days"
      }
    ]
  },

  "data_sources": {
    "leave_request": {
