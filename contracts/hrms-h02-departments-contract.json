{
  "_meta": {
    "id":            "h02-departments",
    "archetype":     "H02 List",
    "page":          "Departments",
    "surface":       "admin",
    "version":       "1.0",
    "last_updated":  "2026-03-22",
    "archetype_ref": "hrms-schema-template.json",
    "seed_page_ref": "frontend/seeds/p2-list.html",
    "gaps":          ["BG-005"]
  },
  "workflow": {
    "primary_actor": "HR Administrator",
    "leads_to": ["H03 Department Detail", "H04 Create Department"],
    "actions": { "primary": "Create Department", "secondary": ["Export"] }
  },
  "api_contract": {
    "services": ["employee-service"],
    "endpoints": {
      "list":    "GET /api/v1/departments",
      "summary": "BG-005: no aggregate — employee count per dept requires join with Employee list",
      "create":  "POST /api/v1/departments"
    }
  },
  "renderer_schema": {
    "dsl_version": "1.0",
    "archetype":   "list",
    "surface":     "admin",
    "page_title":  "Departments",
    "page_states": ["loaded", "skeleton", "empty", "error"],
    "chrome": {
      "sidebar": "slim_54px",
      "header": {
        "title":    "Departments",
        "subtitle": "{{total}} departments · {{employee_total}} employees",
        "actions": [
          { "label": "Export",            "type": "secondary", "icon": "download" },
          { "label": "Create Department", "type": "primary",   "icon": "plus" }
        ]
      }
    },
    "slots": {
      "STATS_STRIP": {
        "required": true,
        "columns":  4,
        "gap_ref":  "BG-005",
        "items": [
          { "key": "total",           "label": "Total",         "source": "BG-005 mock" },
          { "key": "active",          "label": "Active",        "source": "BG-005 mock" },
          { "key": "largest_dept",    "label": "Largest Dept",  "source": "BG-005 mock" },
          { "key": "avg_headcount",   "label": "Avg Headcount", "source": "BG-005 mock" }
        ]
      },
      "FILTER_BAR": {
        "required": true,
        "tabs": [
          { "label": "All",      "filter": null },
          { "label": "Active",   "filter": "status=Active" },
          { "label": "Proposed", "filter": "status=Proposed" }
        ],
        "search": { "placeholder": "Search departments…" }
      },
      "DATA_TABLE": {
        "required": true,
        "source":   "employee-service › Department",
        "row_action": "navigate → H03 Department Detail",
        "columns": [
          { "key": "department",      "label": "Department",      "width_pct": 28, "component": "icon_name" },
          { "key": "code",            "label": "Code",            "width_pct": 10, "font": "mono" },
          { "key": "head_name",       "label": "Head",            "width_pct": 20 },
          { "key": "employee_count",  "label": "Employee Count",  "width_pct": 16, "font": "mono", "sortable": true },
          { "key": "status",          "label": "Status",          "width_pct": 14, "component": "chip", "enum_ref": "ref:api-contracts#Department.status" },
          { "key": "created_at",      "label": "Created",         "width_pct": 12, "format": "date_short", "font": "mono" }
        ]
      },
      "PAGINATION": { "required": true, "default_limit": 12, "options": [12, 25, 50] }
    }
  }
}
