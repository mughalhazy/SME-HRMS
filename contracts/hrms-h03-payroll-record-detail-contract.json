    "RIGHT_COLUMN": [
      {
        "card": "Net Pay",
        "type": "summary-card",
        "primary_value": "net_pay",
        "currency_field": "currency",
        "display": "large-mono",
        "colour": "teal"
      },
      {
        "card": "Record Details",
        "service": "payroll_service",
        "model": "PayrollRecord",
        "endpoint": "GET /api/v1/payroll/records/:recordId",
        "fields": ["payroll_record_id", "pay_period_start", "pay_period_end", "payment_date", "status", "currency"]
      }
    ]
  },

  "data_sources": {
